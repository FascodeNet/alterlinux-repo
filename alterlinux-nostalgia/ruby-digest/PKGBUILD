# Maintainer: hayao <shun819.mail at gmail.com>

# The ruby-digest in archlinux32 extra installs its extensions under
# /usr/lib/ruby/3.0.0/x86-linux/, but the i486 ruby 3.0.5 interpreter only
# looks in i486-linux/, so `require "digest"` (and therefore the gem CLI)
# is broken. Build the digest extensions that match the digest .rb files
# shipped with ruby 3.0.5 and install them into the interpreter's real arch
# directory. Built with plain extconf.rb + make because rake/rake-compiler
# and the gem CLI are unusable until this very package is installed.

pkgname=ruby-digest
pkgver=3.0.5
pkgrel=2
pkgdesc='digest extension modules built for the arch directory the i486 ruby actually uses'
arch=(i486 i686 pentium4)
url='https://github.com/ruby/digest'
license=(BSD-2-Clause Ruby)
depends=(ruby)
source=("https://cache.ruby-lang.org/pub/ruby/3.0/ruby-${pkgver}.tar.xz")
sha512sums=('1c69d18210a2156f7696c678a8d54bf05c4dc49a1401c1ecc5760b1c23fb6ac14053873a225564664d6a327cda274ce72f47d112a6ad8d378f978de4e507e9a0')

_exts=(digest digest/bubblebabble digest/md5 digest/rmd160 digest/sha1 digest/sha2)

build() {
  cd "ruby-${pkgver}"
  local ext
  for ext in "${_exts[@]}"; do
    (cd "ext/${ext}" && ruby extconf.rb && make)
  done
}

package() {
  cd "ruby-${pkgver}"
  local archdir
  archdir="/usr/lib/ruby/3.0.0/$(ruby -e 'puts RbConfig::CONFIG["arch"]')"
  install -Dm755 ext/digest/digest.so "${pkgdir}${archdir}/digest.so"
  local sub
  for sub in bubblebabble md5 rmd160 sha1 sha2; do
    install -Dm755 "ext/digest/${sub}/${sub}.so" "${pkgdir}${archdir}/digest/${sub}.so"
  done
  install -Dm644 ext/digest/lib/digest.rb "${pkgdir}/usr/lib/ruby/3.0.0/digest.rb"
  install -Dm644 ext/digest/sha2/lib/sha2.rb "${pkgdir}/usr/lib/ruby/3.0.0/digest/sha2.rb"
  install -Dm644 ext/digest/digest.h "${pkgdir}/usr/include/ruby-3.0.0/digest.h"
  install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}
