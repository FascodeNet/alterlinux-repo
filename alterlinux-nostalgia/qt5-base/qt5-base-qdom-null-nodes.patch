Subject: [PATCH] QDom: guard null factory results on Qt 5.15
Upstream: https://code.qt.io/cgit/qt/qtbase.git/commit/?id=8b5670485050cbedffe92c9ca48537f89dc896bd

--- a/src/xml/dom/qdomhelpers.cpp
+++ b/src/xml/dom/qdomhelpers.cpp
@@ -387,6 +387,8 @@
     } else {
         n.reset(doc->createTextNode(characters));
     }
+    if (!n)
+        return false;
     n->setLocation(locator->line(), locator->column());
     node->appendChild(n.data());
     n.take();
@@ -409,6 +411,8 @@
 bool QDomBuilder::skippedEntity(const QString &name)
 {
     QDomNodePrivate *n = doc->createEntityReference(name);
+    if (!n)
+        return false;
     n->setLocation(locator->line(), locator->column());
     node->appendChild(n);
     return true;
@@ -442,6 +446,8 @@
 {
     QDomNodePrivate *n;
     n = doc->createComment(characters);
+    if (!n)
+        return false;
     n->setLocation(locator->line(), locator->column());
     node->appendChild(n);
     return true;
