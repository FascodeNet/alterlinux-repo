        smoke.cpp)
sha256sums=('5b2e00eccaf5a4d8c14134ffa0ea8dfd0a35ae1ffc7f8d87fa4305a1ed23cf22'
            '5411edbe215c24b30448fac69bd0ba7c882f545e8cf05027b2b6e2227abc5e78'
            '4b93f6a79039e676a56f9d6990a324a64a36f143916065973ded89adc621e094'
            'fa62ed7cccb40ffd93e65421f0c2763ca8db925e532cbf88042e494c4e9daba8'
            'cb3f378890e84039c0bf444a13e0da8e06d5baab3c35302dad8344727d3bb523'
