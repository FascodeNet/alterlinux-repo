pkgname=(qt6-base
         qt6-xcb-private-headers)
_pkgver=6.11.2
pkgver=${_pkgver/-/}
pkgrel=3.2
arch=(i486)
url='https://www.qt.io'
license=(GPL-3.0-only
         LGPL-3.0-only
         LicenseRef-Qt-Commercial
         Qt-GPL-exception-1.0)
pkgdesc='A cross-platform application and UI framework'
depends=(brotli
