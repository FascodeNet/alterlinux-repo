+/// Reports whether the CPUID instruction exists, by toggling EFLAGS.ID.
+/// Pre-Pentium CPUs (real i486) lack it; running CPUID there raises #UD.
+#[cfg(target_arch = "x86")]
+#[doc(hidden)]
+pub fn x86_has_cpuid() -> bool {
+    let toggled: u32;
+    let original: u32;
+    unsafe {
+        core::arch::asm!(
+            "pushfd",
+            "pop eax",
+            "mov ecx, eax",
+            "xor eax, 0x200000",
+            "push eax",
+            "popfd",
+            "pushfd",
+            "pop eax",
+            "push ecx",
+            "popfd",
+            out("eax") toggled,
+            out("ecx") original,
+        );
+    }
+    (toggled ^ original) & 0x0020_0000 != 0
+}
+
+#[cfg(target_arch = "x86_64")]
+#[doc(hidden)]
+pub fn x86_has_cpuid() -> bool {
+    true
+}
