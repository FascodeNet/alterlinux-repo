# Maintainer: hayao <shun819.mail at gmail.com>

# archlinux32 blacklists rust on i486: rustc has no bootstrap binary for it.
# This builds a self-hosted toolchain instead: the repo's own rust package is
# stage0 (seeded once from the official i686 binaries; see this file before
# pkgrel 2 to reseed a from-scratch repo), and the i686-unknown-linux-gnu spec
# is patched to cpu=i486 with max-atomic-width 32 (no CMPXCHG8B), so stage2
# rustc, std and cargo are all i486-clean and run on a real 486. Links the
# llvm19 package because archlinux32's i486 llvm is stuck at 14, too old for
# rust 1.82. Pinned to 1.82.0 to match archlinux32's rust on i686/pentium4.

pkgname=rust
epoch=1
pkgver=1.82.0
pkgrel=3
pkgdesc='Systems programming language (self-hosted, emits i486 code)'
url='https://www.rust-lang.org/'
arch=(i486)
license=('Apache-2.0 OR MIT')
depends=(bzip2 curl gcc gcc-libs glibc libssh2 llvm19-libs openssl zlib)
makedepends=(cmake llvm19 ninja perl pkgconf python rust)
provides=(cargo=$pkgver)
options=(!debug !lto)
_host=i686-unknown-linux-gnu
source=(https://static.rust-lang.org/dist/rustc-$pkgver-src.tar.xz)
sha256sums=('1276a0bb8fa12288ba6fa96597d28b40e74c44257c051d3bc02c2b049bb38210')

prepare() {
  cd "rustc-$pkgver-src"
  local spec=compiler/rustc_target/src/spec/targets/i686_unknown_linux_gnu.rs
  grep -q '"pentium4"' "$spec" && grep -q 'max_atomic_width = Some(64)' "$spec"
  sed -i -e 's/"pentium4"/"i486"/' \
         -e 's/max_atomic_width = Some(64)/max_atomic_width = Some(32)/' "$spec"

  cat > config.toml <<EOF
change-id = 129295

[llvm]
download-ci-llvm = false
link-shared = true

[build]
build = "$_host"
host = ["$_host"]
target = ["$_host"]
rustc = "/usr/bin/rustc"
cargo = "/usr/bin/cargo"
docs = false
extended = true
tools = ["cargo"]
locked-deps = true
vendor = true

[install]
prefix = "/usr"

[rust]
channel = "stable"
description = "AlterLinux nostalgia"
debuginfo-level = 0
codegen-units-std = 1
rpath = false
deny-warnings = false

[target.$_host]
cc = "/usr/bin/gcc"
cxx = "/usr/bin/g++"
ar = "/usr/bin/ar"
ranlib = "/usr/bin/ranlib"
linker = "/usr/bin/gcc"
llvm-config = "/usr/lib/llvm19/bin/llvm-config"
EOF
}

build() {
  cd "rustc-$pkgver-src"
  # Rust code gets i486 from the patched spec, but the C/C++ parts (llvm-wrapper,
  # compiler-rt, cargo's vendored libs) take march from these; gcc's default here
  # is above i486.
  export CFLAGS='-march=i486 -O2' CXXFLAGS='-march=i486 -O2'
  unset LDFLAGS
  # portable-atomic's x86 asm module assumes CMPXCHG8B, which the patched
  # target lacks; the cfg drops it for stage1+ in favor of its fallback.
  export RUSTFLAGS_NOT_BOOTSTRAP="--cfg portable_atomic_no_asm"
  DESTDIR="$srcdir/dest" python ./x.py install -j "$(nproc)"
}

check() {
  local root="$srcdir/dest" re=$'\t''(cmov|fcmov|fcomi|fucomi|cmpxchg8b|rdtsc|nopl|nopw)|%xmm'
  local bad=0 f
  # librustc_driver and cargo keep runtime-dispatched sha1/sha2 SSE2 paths, so
  # only the artifacts that must be strictly i486-clean are asserted.
  for f in "$root"/usr/lib/libstd-*.so \
           "$root"/usr/lib/rustlib/$_host/lib/lib{std,core,alloc,compiler_builtins}-*.rlib; do
    if objdump -d "$f" | grep -qE "$re"; then
      echo "ERROR: post-i486 instructions in ${f##*/}" >&2
      bad=1
    fi
  done
  return $bad
}

package() {
  rm -f "$srcdir"/dest/usr/lib/rustlib/{install.log,uninstall.sh,rust-installer-version,components} \
        "$srcdir"/dest/usr/lib/rustlib/manifest-*
  cp -a "$srcdir"/dest/. "$pkgdir/"
  install -Dm644 "$srcdir/rustc-$pkgver-src/"{LICENSE-APACHE,LICENSE-MIT} \
    -t "$pkgdir/usr/share/licenses/$pkgname/"
}
