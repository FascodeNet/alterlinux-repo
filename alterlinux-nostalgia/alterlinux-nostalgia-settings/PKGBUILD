# Maintainer: hayao <shun819.mail at gmail.com>

# Low-memory defaults for the archlinux32 nostalgia profile (i486, 128 MB,
# non-PAE). Heavy systemd units are masked with /dev/null symlinks in
# /etc/systemd/system: a /usr/lib vendor mask would collide with the unit
# files the systemd package itself owns. preset only sets enable/disable and
# cannot mask, so it stays a separate layer. Ships the IceWM desktop bits:
# a nostalgia theme, tty1 X autostart and xterm defaults.

pkgname=alterlinux-nostalgia-settings
pkgver=2
pkgrel=1
pkgdesc='Low-memory systemd/kernel defaults for the archlinux32 nostalgia profile'
arch=(any)
url='https://github.com/FascodeNet/alterlinux-repo'
license=(MIT)
optdepends=('earlyoom: userspace OOM killer that keeps a 128 MB box responsive'
            'zram-generator: compressed swap in RAM'
            'icewm: lightweight desktop autostarted on tty1'
            'xorg-xinit: required for the tty1 X autostart'
            'xorg-xrdb: apply the bundled xterm Xresources'
            'ttf-dejavu: fonts referenced by the IceWM theme')
source=(journald-volatile.conf
        99-nost-lowmem.conf
        00-nost.preset
        nost-startx.sh
        xinitrc-icewm
        Xresources
        menu
        preferences
        default.theme
        closeA.png
        closeI.png
        maximizeA.png
        maximizeI.png
        minimizeA.png
        minimizeI.png
        restoreA.png
        restoreI.png
        start-taskbar.png)
b2sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
        'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

# Never mask getty@.service itself (kills every console) or getty@tty1/tty2.
_mask=(
  systemd-resolved.service
  systemd-homed.service
  systemd-homed-activate.service
  systemd-userdbd.service
  systemd-userdbd.socket
  systemd-networkd-wait-online.service
  systemd-oomd.service
  getty@tty3.service
  getty@tty4.service
  getty@tty5.service
  getty@tty6.service
  # systemd-timesyncd.service   # kept: retro boxes with a dead RTC need NTP
)

package() {
  install -d "$pkgdir/etc/systemd/system"
  local u
  for u in "${_mask[@]}"; do
    ln -s /dev/null "$pkgdir/etc/systemd/system/$u"
  done

  install -Dm644 journald-volatile.conf "$pkgdir/usr/lib/systemd/journald.conf.d/00-nost-volatile.conf"
  install -Dm644 99-nost-lowmem.conf "$pkgdir/usr/lib/sysctl.d/99-nost-lowmem.conf"
  install -Dm644 00-nost.preset "$pkgdir/usr/lib/systemd/system-preset/00-nost.preset"

  install -Dm644 nost-startx.sh "$pkgdir/etc/profile.d/nost-startx.sh"
  install -Dm644 xinitrc-icewm "$pkgdir/etc/skel/.xinitrc"
  install -Dm644 Xresources "$pkgdir/etc/skel/.Xresources"
  install -Dm644 menu "$pkgdir/etc/icewm/menu"
  install -Dm644 preferences "$pkgdir/etc/icewm/preferences"

  local t
  for t in default.theme closeA.png closeI.png maximizeA.png maximizeI.png \
           minimizeA.png minimizeI.png restoreA.png restoreI.png; do
    install -Dm644 "$t" "$pkgdir/usr/share/icewm/themes/nostalgia/$t"
  done
  install -Dm644 start-taskbar.png "$pkgdir/usr/share/icewm/themes/nostalgia/taskbar/start.png"
}
