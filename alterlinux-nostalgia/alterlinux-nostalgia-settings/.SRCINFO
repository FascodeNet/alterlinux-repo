pkgbase = alterlinux-nostalgia-settings
	pkgdesc = Low-memory systemd/kernel defaults for the archlinux32 nostalgia profile
	pkgver = 2
	pkgrel = 1
	url = https://github.com/FascodeNet/alterlinux-repo
	arch = any
	license = MIT
	optdepends = earlyoom: userspace OOM killer that keeps a 128 MB box responsive
	optdepends = zram-generator: compressed swap in RAM
	optdepends = icewm: lightweight desktop autostarted on tty1
	optdepends = xorg-xinit: required for the tty1 X autostart
	optdepends = xorg-xrdb: apply the bundled xterm Xresources
	optdepends = ttf-dejavu: fonts referenced by the IceWM theme
	source = journald-volatile.conf
	source = 99-nost-lowmem.conf
	source = 00-nost.preset
	source = nost-startx.sh
	source = xinitrc-icewm
	source = Xresources
	source = menu
	source = preferences
	source = default.theme
	source = closeA.png
	source = closeI.png
	source = maximizeA.png
	source = maximizeI.png
	source = minimizeA.png
	source = minimizeI.png
	source = restoreA.png
	source = restoreI.png
	source = start-taskbar.png
