# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: Andrea Scarpino <andrea@archlinux.org>

pkgname=qt6-shadertools
_pkgver=6.11.2
pkgver=${_pkgver/-/}
pkgrel=1
arch=(i486)
url='https://www.qt.io'
license=(GPL-3.0-only
         LGPL-3.0-only
         LicenseRef-Qt-Commercial
         Qt-GPL-exception-1.0)
pkgdesc='Provides functionality for the shader pipeline that allows Qt Quick to operate on Vulkan, Metal, and Direct3D, in addition to OpenGL'
depends=(glibc
         libgcc
         libstdc++
         qt6-base)
makedepends=(cmake
             git
             ninja)
groups=(qt6)
_pkgfn=${pkgname/6-/}
source=(https://download.qt.io/archive/qt/6.11/$_pkgver/submodules/$_pkgfn-everywhere-src-$_pkgver.tar.xz)
sha256sums=('805046b8b7757665586890b375940047e874ae3ab00adb6d3f2b38fc6b200b1c')

prepare() {
  mv "$_pkgfn-everywhere-src-$_pkgver" "$_pkgfn"
}

build() {
  cmake -B build -S $_pkgfn -G Ninja \
    -DCMAKE_MESSAGE_LOG_LEVEL=STATUS
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -d "$pkgdir"/usr/share/licenses
  ln -s /usr/share/licenses/qt6-base "$pkgdir"/usr/share/licenses/$pkgname
}
