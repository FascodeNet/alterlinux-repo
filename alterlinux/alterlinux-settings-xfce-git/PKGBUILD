_pkgname=alterlinux-settings-xfce
pkgname=$_pkgname-git
pkgver=2.r2.029d4cb
pkgrel=1
pkgdesc='AlterLinux Xfce desktop default settings'
arch=('any')
url='https://github.com/FascodeNet/alterlinux-settings-xfce'
makedepends=('git')
source=("git+https://github.com/FascodeNet/${_pkgname}.git")
conflicts=("${_pkgname}")
provides=("${_pkgname}")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$_pkgname"
    printf "2.r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
    cp -r "$srcdir/$_pkgname/etc" "$pkgdir/"
    cp -r "$srcdir/$_pkgname/usr" "$pkgdir/"
}
